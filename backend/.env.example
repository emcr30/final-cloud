# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# development | production
ENVIRONMENT=development

# Origen(es) del frontend permitidos por CORS, separados por coma
# Local: http://localhost:5173 · Prod: https://canchaya.vercel.app
FRONTEND_URL=http://localhost:5173

# Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key: acceso total, salta RLS. SOLO en el backend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe (modo prueba) → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Opcional: solo si configuras el webhook (Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# pen o usd (si Stripe de prueba no acepta PEN)
MONEDA=pen

# Resend → API Keys
RESEND_API_KEY=re_...
# Sin dominio propio solo funciona onboarding@resend.dev
EMAIL_FROM=CanchaYa <onboarding@resend.dev>

# Secreto compartido para que pg_cron llame a /tareas/* (header X-Cron-Secret)
CRON_SECRET=cambia-esto-por-un-valor-aleatorio

TIMEZONE=America/Lima
