# Copia este archivo como .env y completa los valores.
# Solo las variables con prefijo VITE_ llegan al navegador (son públicas).

# Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://tvefiatclvdseztwopyr.supabase.co
# Supabase → Settings → API Keys → Publishable key (sb_publishable_...) o la legacy anon (eyJ...).
# Es pública; la protección la da RLS.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# URL del backend FastAPI (local: http://localhost:8000 · prod: https://canchaya-api.onrender.com)
VITE_API_URL=http://localhost:8000
